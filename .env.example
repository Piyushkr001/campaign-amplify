# Campaign Amplification Platform - Public Mobile Client Configuration
# WARNING: Only public configurations belong here (prefixed with EXPO_PUBLIC_)
# NEVER put private keys, JWT secrets, or DB passwords in this file!

# Set to 'true' to use the live Express + Neon PostgreSQL backend.
# Set to 'false' (or omit) to run in offline local prototype mode (Zustand + AsyncStorage).
EXPO_PUBLIC_USE_API=false

# Strict API Development Mode:
# Set to 'true' to disable silent fallback to local mock campaigns on API errors.
# When true and USE_API=true, network or backend errors will surface directly to the UI
# allowing engineers to inspect and debug real API failures.
# Default: false
EXPO_PUBLIC_STRICT_API=false

# Backend API Base URL Configuration:
# - iOS Simulator:          http://localhost:5001/api/v1
# - Android Emulator:       http://10.0.2.2:5001/api/v1
# - Physical Mobile Device: http://<MACHINE_LAN_IP>:5001/api/v1 (e.g. http://192.168.1.100:5001/api/v1)
# - Production API:         https://api.campaignamplify.org/v1
EXPO_PUBLIC_API_URL=http://localhost:5001/api/v1

EXPO_PUBLIC_APP_ENV=development
