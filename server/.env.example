# Campaign Amplify - Backend Server Environment Variables
# Copy to .env for local development

PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:8081

# Neon PostgreSQL Connection String (Pooler or Direct)
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-123456.us-east-2.aws.neon.tech/campaign_amplify?sslmode=require

# JWT Authentication (Keep secret out of source control)
# In production, this MUST be supplied and be at least 32 characters long.
JWT_SECRET=replace-with-strong-random-secret
JWT_EXPIRES_IN=8h

# AI Drafting Engine (Optional: uses high-quality deterministic fallback if unset)
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

