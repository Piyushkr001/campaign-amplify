# Campaign Amplify - Backend Server Environment Variables
# Copy to .env for local development

PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:8081

# Neon PostgreSQL Connection String (Pooler or Direct)
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-123456.us-east-2.aws.neon.tech/campaign_amplify?sslmode=require

# JWT Authentication (Keep secret out of source control)
JWT_SECRET=your-secure-jwt-secret-here
JWT_EXPIRES_IN=8h
